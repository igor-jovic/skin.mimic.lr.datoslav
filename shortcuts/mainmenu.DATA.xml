<!-- datoslav: home menu is Filmovi, TV serije, Podešavanja only.
     With "Combine main menu and submenu" on, Enter on a closed entry opens its submenu (the SetProperty
     Skin Shortcuts adds) and Enter on an open one runs the action below, which closes it again. The full
     film list is "Svi filmovi" in the Filmovi submenu. Needs the patched Skin Shortcuts toggle (DATOSLAV.md). -->
<shortcuts>
	<shortcut>
		<defaultID>movies</defaultID>
		<label>342</label>
		<label2>Common menu item</label2>
		<icon>DefaultMovies.png</icon>
		<thumb>DefaultMovies.png</thumb>
		<action>ClearProperty(submenuVisibility,10000)</action>
	</shortcut>
	<shortcut>
		<defaultID>tvshows</defaultID>
		<label>20343</label>
		<label2>Custom item</label2>
		<icon>DefaultTVShows.png</icon>
		<thumb>DefaultTVShows.png</thumb>
		<action>ClearProperty(submenuVisibility,10000)</action>
	</shortcut>
	<shortcut>
		<defaultID>settings</defaultID>
		<label>5</label>
		<label2>Common menu item</label2>
		<icon>DefaultIconSettings.png</icon>
		<thumb>DefaultIconSettings.png</thumb>
		<action>ClearProperty(submenuVisibility,10000)</action>
	</shortcut>
</shortcuts>
