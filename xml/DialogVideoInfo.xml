<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">350</defaultcontrol>
	<onload>SendClick(9000,5)</onload>
	<!-- datoslav: a film or an episode opens as a pop-up of actions (group 9500 at the end); "details" reveals this page -->
	<onload condition="String.IsEqual(ListItem.DBTYPE,movie) + !ListItem.IsResumable">SetFocus(9501)</onload>
	<onload condition="String.IsEqual(ListItem.DBTYPE,episode) + !ListItem.IsResumable">SetFocus(9511)</onload>
	<onload condition="[String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)] + ListItem.IsResumable">SetFocus(9502)</onload>
	<!-- the "more like this" row draws only items made for this title -->
	<onload>SetProperty(datoslav.rowfor,$INFO[ListItem.DBType]-$INFO[ListItem.DBID],movieinformation)</onload>
	<onunload>ClearProperty(datoslav.details,movieinformation)</onunload>
	<onunload>ClearProperty(datoslav.rowfor,movieinformation)</onunload>
	<controls>
		<include>Topbar</include>

		<!-- datoslav: no poster on a film's, show's or episode's page; info lines and description side by side.
		     Higher than the original, as there is no top bar here. -->
