	<!-- layout_includes -->
	<include name="KeibertzPlusLayoutDefault">
		<!-- datoslav: Arcade's two dark panels behind the text; the inner one stops before the actor list -->
		<control type="image">
			<left>60</left>
			<top>471</top>
			<right>60</right>
			<bottom>40</bottom>
			<texture colordiffuse="66000000" border="5">listselect_fo.png</texture>
		</control>
		<control type="image">
			<left>70</left>
			<top>481</top>
			<right>654</right>
			<bottom>50</bottom>
			<texture colordiffuse="66000000" border="5">listselect_fo.png</texture>
		</control>
		<control type="label">
            <left>100</left>
            <top>491</top>
            <width>1126</width>
            <height>60</height>
            <align>left</align>
            <aligny>center</aligny>
            <font>font35_title</font>
            <label>[B]$VAR[ListItemLabel][/B]</label>			
            <textcolor>TitleTextColor</textcolor>
            <shadowcolor>shadow</shadowcolor>
            <scroll>true</scroll>
        </control>
		<control type="label">
			<left>100</left>
			<top>571</top>
			<width max="1126">auto</width>
			<height>40</height>
			<align>left</align>
			<aligny>center</aligny>
			<font>font15</font>
			<label>[B][UPPERCASE]$VAR[KeibertzPlusInfoLine][/UPPERCASE][/B]</label>
			<textcolor>AltTextColor</textcolor>
			<shadowcolor>shadow</shadowcolor>
			<scroll>false</scroll>
		</control>
		<control type="textbox">
            <left>100</left>
            <top>636</top>
            <width>1126</width>
            <!-- datoslav: scrolling text draws about 15 below the box, so it ends above the inner panel's edge (1030) -->
            <height>370</height>
            <align>justify</align>
            <font>font13</font>
            <label>$INFO[ListItem.Plot]</label>			
            <textcolor>NormalTextColor</textcolor>
            <shadowcolor>shadow</shadowcolor>
            <autoscroll time="4000" delay="3000" repeat="5000">!Skin.HasSetting(Disable.AutoScroll) + Control.HasFocus(902)</autoscroll>
        </control>
		<!-- datoslav: how far a film stopped part-way was watched, above the actors -->
		<control type="group">
			<visible>ListItem.IsResumable</visible>
			<left>606r</left>
			<top>494</top>
			<control type="label">
				<width>526</width>
				<height>40</height>
				<aligny>center</aligny>
				<font>font14</font>
				<label>$LOCALIZE[31630]</label>
				<textcolor>NormalTextColor</textcolor>
				<shadowcolor>shadow</shadowcolor>
			</control>
			<control type="progress">
				<top>48</top>
				<width>526</width>
				<height>12</height>
				<info>ListItem.PercentPlayed</info>
			</control>
		</control>
		<!-- datoslav: top 5 actors instead of the fanart box. Kodi doesn't load the cast for library list items, so
		     borca-media-syncher writes the first five names into the tagline ("• Name[CR]• Name…"), which it does load.
		     The tagline is shown nowhere else in this skin. -->
		<control type="textbox">
			<left>606r</left>
			<top>636</top>
			<width>526</width>
			<height>384</height>
			<font>font14</font>
			<label>$INFO[ListItem.Tagline]</label>
			<textcolor>NormalTextColor</textcolor>
			<shadowcolor>shadow</shadowcolor>
		</control>
		<!-- datoslav: the videoteka add-on's titles have no actors; their status takes that place as a large strip -->
		<control type="group">
			<visible>$EXP[isVideotekaList]</visible>
			<left>606r</left>
			<top>636</top>
			<include content="BadgeStrips">
				<param name="top" value="0" />
				<param name="width" value="526" />
				<param name="height" value="110" />
				<param name="font" value="font35_title" />
			</include>
		</control>
	</include>
</includes>