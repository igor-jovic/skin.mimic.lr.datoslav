            <control type="group">
                <visible>!String.IsEmpty(ListItem.Property(badge))</visible>
                <include content="BadgeStrip">
                    <param name="badge" value="available" />
                    <param name="color" value="E62E7D32" />
                    <param name="label" value="31951" />
                    <param name="top" value="$PARAM[top]" />
                    <param name="left" value="$PARAM[left]" />
                    <param name="width" value="$PARAM[width]" />
                    <param name="height" value="$PARAM[height]" />
                    <param name="font" value="$PARAM[font]" />
                </include>
                <include content="BadgeStrip">
                    <param name="badge" value="requested" />
                    <param name="color" value="E61565C0" />
                    <param name="label" value="31952" />
                    <param name="top" value="$PARAM[top]" />
                    <param name="left" value="$PARAM[left]" />
                    <param name="width" value="$PARAM[width]" />
                    <param name="height" value="$PARAM[height]" />
                    <param name="font" value="$PARAM[font]" />
                </include>
                <include content="BadgeStrip">
                    <param name="badge" value="accepted" />
                    <param name="color" value="E600897B" />
                    <param name="label" value="31953" />
                    <param name="top" value="$PARAM[top]" />
                    <param name="left" value="$PARAM[left]" />
                    <param name="width" value="$PARAM[width]" />
                    <param name="height" value="$PARAM[height]" />
                    <param name="font" value="$PARAM[font]" />
                </include>
                <include content="BadgeStrip">
                    <param name="badge" value="declined" />
                    <param name="color" value="E6B71C1C" />
                    <param name="label" value="31954" />
                    <param name="top" value="$PARAM[top]" />
                    <param name="left" value="$PARAM[left]" />
                    <param name="width" value="$PARAM[width]" />
                    <param name="height" value="$PARAM[height]" />
                    <param name="font" value="$PARAM[font]" />
                </include>
            </control>
        </definition>
    </include>
    <include name="BadgeStrip">
        <definition>
            <control type="group">
                <visible>String.IsEqual(ListItem.Property(badge),$PARAM[badge])</visible>
                <control type="image">
                    <left>$PARAM[left]</left>
                    <top>$PARAM[top]</top>
                    <width>$PARAM[width]</width>
                    <height>$PARAM[height]</height>
                    <texture colordiffuse="$PARAM[color]">white.png</texture>
