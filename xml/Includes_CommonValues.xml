    <!-- datoslav: what marks the selected film pop-up button: a thick white frame inside it and a pointer either side -->
    <include name="FilmPopupFocusMarks">
        <control type="group">
            <visible>Control.HasFocus($PARAM[id])</visible>
            <control type="image"><left>100</left><width>900</width><height>10</height><texture>white.png</texture></control>
            <control type="image"><left>100</left><top>120</top><width>900</width><height>10</height><texture>white.png</texture></control>
            <control type="image"><left>100</left><width>10</width><height>130</height><texture>white.png</texture></control>
            <control type="image"><left>990</left><width>10</width><height>130</height><texture>white.png</texture></control>
            <control type="image"><left>30</left><top>35</top><width>50</width><height>60</height><texture>datoslav/pointer_right.png</texture></control>
            <control type="image"><left>1020</left><top>35</top><width>50</width><height>60</height><texture flipx="true">datoslav/pointer_right.png</texture></control>
        </control>
    </include>
    <!-- datoslav: what goes inside one selectable row (a 1100 x 130 group) of the film pop-up. Params: id, label
         (text number). What the button does and where Up and Down go is written inside the include tag and lands
         at <nested />, which Kodi only fills when it is a direct child of a top-level control here -->
    <include name="FilmPopupRow">
        <control type="button" id="$PARAM[id]">
            <left>100</left>
            <width>900</width>
            <height>130</height>
            <font>font35_title</font>
            <label>$PARAM[label]</label>
            <textcolor>00FFFFFF</textcolor>
            <focusedcolor>00FFFFFF</focusedcolor>
            <shadowcolor>00000000</shadowcolor>
            <texturenofocus colordiffuse="BorderDiffuse" border="5">listselect_fo.png</texturenofocus>
            <nested />
        </control>
        <include content="FilmPopupRowText">
            <param name="label" value="$LOCALIZE[$PARAM[label]]" />
            <param name="visible" value="!Control.HasFocus($PARAM[id])" />
        </include>
        <include content="FilmPopupRowText">
            <param name="label" value="[B]$LOCALIZE[$PARAM[label]][/B]" />
            <param name="visible" value="Control.HasFocus($PARAM[id])" />
        </include>
        <include content="FilmPopupFocusMarks">
            <param name="id" value="$PARAM[id]" />
        </include>
    </include>
    <!-- datoslav: a pop-up row's text, drawn over the button because a button cannot turn bold with focus -->
    <include name="FilmPopupRowText">
        <control type="label">
            <left>100</left>
            <width>900</width>
            <height>130</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>font35_title</font>
            <label>$PARAM[label]</label>
            <textcolor>FFFFFFFF</textcolor>
            <visible>$PARAM[visible]</visible>
        </control>
    </include>
    <!-- datoslav: Back on a film's details page returns to the pop-up, on its last row. The second line is a
         move to that row: without a control to move to, Kodi runs the first line and then closes the page anyway.
         Goes on the lists and scrollbars, and on the button group, whose buttons inherit it -->
    <include name="FilmDetailsBack">
        <onback condition="!String.IsEmpty(Window(movieinformation).Property(datoslav.details))">ClearProperty(datoslav.details,movieinformation)</onback>
        <onback condition="!String.IsEmpty(Window(movieinformation).Property(datoslav.details))">9505</onback>
    </include>
    <!-- datoslav: one poster of the details page's "more like this" row. Items left over from the previous title
         stay until the new list arrives, so an item is drawn only when its row.for matches the page -->
    <include name="MoreLikeThisItem">
        <param name="focused" default="false" />
        <definition>
            <control type="group">
                <visible>String.IsEqual(ListItem.Property(row.for),Window(movieinformation).Property(datoslav.rowfor))</visible>
                <control type="image">
                    <visible>$PARAM[focused]</visible>
                    <left>-9</left>
                    <top>6</top>
                    <width>243</width>
                    <height>355</height>
                    <texture colordiffuse="FocusColor" border="5">listselect_fo.png</texture>
                </control>
                <control type="image">
                    <top>15</top>
                    <width>225</width>
                    <height>337</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <!-- a title without a poster gets a plain tile with its name -->
                <control type="group">
                    <visible>String.IsEmpty(ListItem.Art(poster))</visible>
                    <control type="image">
                        <top>15</top>
                        <width>225</width>
                        <height>337</height>
                        <texture colordiffuse="33FFFFFF">white.png</texture>
                    </control>
                    <control type="textbox">
                        <left>15</left>
                        <top>81</top>
                        <width>195</width>
                        <height>256</height>
                        <font>font16</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </control>
                <include content="BadgeStrips">
                    <param name="top" value="15" />
                    <param name="width" value="225" />
                    <param name="height" value="51" />
                    <param name="font" value="font13" />
                </include>
                <control type="textbox">
                    <visible>!$PARAM[focused]</visible>
                    <top>369</top>
                    <width>225</width>
                    <height>108</height>
                    <font>font16</font>
                    <align>center</align>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="textbox">
                    <visible>$PARAM[focused]</visible>
                    <top>369</top>
                    <width>225</width>
                    <height>108</height>
                    <font>font16</font>
                    <align>center</align>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>[B]$INFO[ListItem.Label][/B]</label>
                </control>
            </control>
        </definition>
    </include>
    <!-- datoslav: the request status strip across the top of a poster: the "more like this" row's by default,
         and the poster views' for the add-on's lists. Library items have no badge, so it never shows there. -->
    <include name="BadgeStrips">
        <param name="left" default="0" />
        <param name="top" default="10" />
        <param name="width" default="150" />
        <param name="height" default="34" />
