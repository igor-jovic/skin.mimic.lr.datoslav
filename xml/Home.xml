<?xml version="1.0" encoding="utf-8"?>
<window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <allowoverlay>no</allowoverlay>
    <onload>SetProperty(CurrentSkin,skin.mimic.lr.datoslav,home)</onload>
    <onload>RunScript(script.skinshortcuts,type=buildxml&amp;mode=single&amp;mainmenuID=9000&amp;group=mainmenu|quicknav)</onload>

    <onload>ClearProperty(MediaMenu,Home)</onload>
    <!-- datoslav: the videoteka add-on's Pogledaj marks the library list it opened, so Back to here lands on that
         entry, set before the first frame. Positions in the combined menu with that submenu open; Pogledaj means the
         library has films (or shows), so every entry above is there. -->
    <onload condition="String.IsEqual(Window(home).Property(datoslav.homemenu),movie)">SetProperty(submenuVisibility,movies,home)</onload>
    <onload condition="String.IsEqual(Window(home).Property(datoslav.homemenu),movie)">SetFocus(9000,4,absolute)</onload>
    <onload condition="String.IsEqual(Window(home).Property(datoslav.homemenu),tv)">SetProperty(submenuVisibility,num-31967,home)</onload>
    <onload condition="String.IsEqual(Window(home).Property(datoslav.homemenu),tv)">SetFocus(9000,5,absolute)</onload>
    <onload>ClearProperty(datoslav.homemenu,home)</onload>
    <controls>
        <!-- datoslav: Nezavršeni and Nezavršene look here before opening, to show a pop-up instead of an empty list.
             Kodi fills only a list that is visible, so these are visible but one pixel and off the screen -->
        <control type="list" id="9311">
            <left>-10</left>
            <top>-10</top>
            <width>1</width>
            <height>1</height>
            <itemlayout width="1" height="1" />
            <focusedlayout width="1" height="1" />
            <content target="videos" limit="1">special://skin/extras/inprogress_movies.xsp</content>
        </control>
        <control type="list" id="9312">
            <left>-10</left>
            <top>-10</top>
            <width>1</width>
            <height>1</height>
            <itemlayout width="1" height="1" />
            <focusedlayout width="1" height="1" />
            <content target="videos" limit="1">library://video/tvshows/inprogressshows.xml/</content>
        </control>
        <!-- datoslav: the list's "Povratak nazad" row sends Back and then SetFocus(50) to land on the list.
             When Back leaves for the home screen, that focus request arrives here; without a control 50
             nothing is focused and the next key press is swallowed. This catches it and hands focus to the menu. -->
        <control type="button" id="50">
            <left>-10</left>
            <top>-10</top>
            <width>1</width>
            <height>1</height>
            <texturefocus />
            <texturenofocus />
            <onfocus>SetFocus(9000)</onfocus>
        </control>
        <control type="wraplist" id="9033">
            <include>HiddenList</include>
            <content>$INFO[Container(9010).ListItem.Property(backgroundPlaylist)]</content>
            <autoscroll time="7000" delay="7000" repeat="7000">!Skin.HasSetting(Disable.AutoScroll) + String.IsEqual(Container(9010).ListItem.Property(background),playlistBackground)</autoscroll>
            <visible>String.IsEqual(Container(9010).ListItem.Property(background),playlistBackground)</visible>
        </control>
        <control type="wraplist" id="9034">
            <include>HiddenList</include>
            <content>$INFO[Container(9000).ListItem.Property(backgroundPlaylist)]</content>
            <autoscroll time="7000" delay="7000" repeat="7000">!Skin.HasSetting(Disable.AutoScroll) + String.IsEqual(Container(9000).ListItem.Property(background),playlistBackground)</autoscroll>
            <visible>String.IsEqual(Container(9000).ListItem.Property(background),playlistBackground)</visible>
        </control>
        <control type="multiimage">
            <include>FullscreenDimensions</include>
            <include>BackgroundFadeAnimation</include>
            <imagepath background="true">$VAR[HomeBackgroundVar]</imagepath>
        </control>
        <include>skinshortcuts-template-WidgetFanart</include>
        <control type="visualisation">
            <visible>Player.HasAudio + !Skin.HasSetting(Disable.ShowBackgroundVis) + !SlideShow.IsActive</visible>
            <include>FullscreenDimensions</include>
        </control>
        <control type="group">
            <visible>Player.HasVideo + !Skin.HasSetting(Disable.ShowBackgroundVideo) + !SlideShow.IsActive</visible>
            <control type="image">
                <include>FullscreenDimensions</include>
                <texture>black.png</texture>
            </control>
            <control type="videowindow">
                <include>FullscreenDimensions</include>
            </control>
        </control>
        <control type="image">
            <include>FullscreenDimensions</include>
            <texture>$VAR[CommonBackgroundOverlay]</texture>
            <colordiffuse>BackgroundColor</colordiffuse>
        </control>
        <include>Topbar</include>
        <include condition="!Skin.HasSetting(Enable.HorizontalMenu)">HomeVertical</include>
        <include condition="Skin.HasSetting(Enable.HorizontalMenu)">HomeHorizontal</include>
        <control type="label">
            <visible>![Window.IsVisible(favouritesbrowser) | Window.IsVisible(script-globalsearch-main.xml) | Window.IsVisible(script-lazytv-main.xml) | Window.IsVisible(script-lazytv-BigScreenList.xml)]</visible>
            <animation effect="slide" time="0" start="0,0" end="-212,-60" condition="Skin.HasSetting(Enable.HorizontalMenu)">Conditional</animation>
            <include>Animation.Common</include>
            <top>210</top>
            <left>594</left>
            <width>1200</width>
            <height>780</height>
            <align>center</align>
            <label>$VAR[HomeEmptyLibrary]</label>
            <font>font16</font>
            <wrapmultiline>true</wrapmultiline>
        </control>
		<include>weather-details-zoom</include>
    </controls>
</window>